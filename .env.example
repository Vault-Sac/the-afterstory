# Supabase Configuration
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Trip Configuration (optional overrides)
VITE_TRIP_START=2026-10-15T14:00:00+05:30
VITE_TRIP_END=2026-10-20T14:05:00+05:30

# NEVER put service_role key or any secret in this file or in VITE_ variables.
# Service-role key must only be used in trusted server-side functions (Supabase Edge Functions).

# Supabase Configuration
# Obtain these from your Supabase project dashboard → Settings → API
# Or automatically provided if connecting Supabase through Vercel Integration
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# You can use either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Trip Itinerary Configuration (Optional overrides)
VITE_TRIP_START=2026-10-15T14:00:00+05:30
VITE_TRIP_END=2026-10-20T14:05:00+05:30

# SECURITY NOTE:
# NEVER commit .env with real credentials.
# NEVER place supabase service_role secret keys in VITE_ variables, as Vite bundles them into client JS.
